{
  "schema_version": "saas.deployment.topology.v1",
  "module": "saas-starter",
  "namespace": "saas-starter",
  "services": [
    {
      "name": "accounts",
      "endpoints": [
        {
          "name": "connect",
          "api": "CODEFLY_API_CONNECT",
          "visibility": "ENDPOINT_VISIBILITY_PRIVATE",
          "port": 8080
        },
        {
          "name": "grpc",
          "api": "CODEFLY_API_GRPC",
          "visibility": "ENDPOINT_VISIBILITY_PRIVATE",
          "port": 9090
        },
        {
          "name": "rest",
          "api": "CODEFLY_API_REST",
          "visibility": "ENDPOINT_VISIBILITY_PRIVATE",
          "port": 8080
        }
      ],
      "dependencies": [
        {
          "service": "cache",
          "endpoints": [
            "read",
            "write"
          ]
        },
        {
          "service": "object-storage",
          "endpoints": [
            "accounts"
          ]
        },
        {
          "service": "store",
          "endpoints": [
            "tcp"
          ]
        },
        {
          "service": "telemetry",
          "endpoints": [
            "grpc"
          ]
        },
        {
          "service": "vault",
          "endpoints": [
            "http"
          ]
        }
      ]
    },
    {
      "name": "auth-sidecar",
      "endpoints": [
        {
          "name": "grpc",
          "api": "CODEFLY_API_GRPC",
          "visibility": "ENDPOINT_VISIBILITY_MODULE",
          "port": 9090
        },
        {
          "name": "rest",
          "api": "CODEFLY_API_REST",
          "visibility": "ENDPOINT_VISIBILITY_PRIVATE",
          "port": 8080
        }
      ],
      "dependencies": [
        {
          "service": "accounts",
          "endpoints": [
            "connect",
            "grpc",
            "rest"
          ]
        },
        {
          "service": "cache",
          "endpoints": [
            "write"
          ]
        },
        {
          "service": "telemetry",
          "endpoints": [
            "grpc"
          ]
        }
      ]
    },
    {
      "name": "cache",
      "endpoints": [
        {
          "name": "read",
          "api": "CODEFLY_API_TCP",
          "visibility": "ENDPOINT_VISIBILITY_PRIVATE",
          "port": 6379
        },
        {
          "name": "write",
          "api": "CODEFLY_API_TCP",
          "visibility": "ENDPOINT_VISIBILITY_PRIVATE",
          "port": 6379
        }
      ]
    },
    {
      "name": "frontend",
      "endpoints": [
        {
          "name": "http",
          "api": "CODEFLY_API_HTTP",
          "visibility": "ENDPOINT_VISIBILITY_PUBLIC",
          "port": 3000
        }
      ],
      "dependencies": [
        {
          "service": "auth-sidecar",
          "endpoints": [
            "rest"
          ]
        }
      ]
    },
    {
      "name": "marketing",
      "endpoints": [
        {
          "name": "http",
          "api": "CODEFLY_API_HTTP",
          "visibility": "ENDPOINT_VISIBILITY_PUBLIC",
          "port": 3000
        }
      ]
    },
    {
      "name": "object-storage",
      "endpoints": [
        {
          "name": "accounts",
          "api": "CODEFLY_API_TCP",
          "visibility": "ENDPOINT_VISIBILITY_PRIVATE",
          "port": 9000
        }
      ]
    },
    {
      "name": "store",
      "endpoints": [
        {
          "name": "tcp",
          "api": "CODEFLY_API_TCP",
          "visibility": "ENDPOINT_VISIBILITY_EXTERNAL",
          "port": 5432
        }
      ]
    },
    {
      "name": "telemetry",
      "endpoints": [
        {
          "name": "grpc",
          "api": "CODEFLY_API_GRPC",
          "visibility": "ENDPOINT_VISIBILITY_PRIVATE",
          "port": 8080
        }
      ]
    },
    {
      "name": "temporal",
      "endpoints": [
        {
          "name": "grpc",
          "api": "CODEFLY_API_TCP",
          "visibility": "ENDPOINT_VISIBILITY_MODULE",
          "port": 7233
        },
        {
          "name": "http",
          "api": "CODEFLY_API_TCP",
          "visibility": "ENDPOINT_VISIBILITY_MODULE",
          "port": 8233
        }
      ],
      "dependencies": [
        {
          "service": "temporal-store",
          "endpoints": [
            "tcp"
          ]
        }
      ]
    },
    {
      "name": "temporal-store",
      "endpoints": [
        {
          "name": "tcp",
          "api": "CODEFLY_API_TCP",
          "visibility": "ENDPOINT_VISIBILITY_EXTERNAL",
          "port": 5432
        }
      ]
    },
    {
      "name": "vault",
      "endpoints": [
        {
          "name": "http",
          "api": "CODEFLY_API_HTTP",
          "visibility": "ENDPOINT_VISIBILITY_MODULE",
          "port": 8200
        }
      ]
    }
  ],
  "interface_endpoints": [
    {
      "service": "auth-sidecar",
      "endpoint": "grpc",
      "visibility": "ENDPOINT_VISIBILITY_MODULE"
    },
    {
      "service": "frontend",
      "endpoint": "http",
      "visibility": "ENDPOINT_VISIBILITY_PUBLIC"
    },
    {
      "service": "marketing",
      "endpoint": "http",
      "visibility": "ENDPOINT_VISIBILITY_PUBLIC"
    }
  ],
  "public_egress": [
    {
      "service": "accounts",
      "ports": [
        443
      ]
    },
    {
      "service": "frontend",
      "ports": [
        443
      ]
    },
    {
      "service": "marketing",
      "ports": [
        443
      ]
    },
    {
      "service": "telemetry",
      "ports": [
        443
      ]
    }
  ]
}
