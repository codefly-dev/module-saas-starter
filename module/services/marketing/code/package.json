{
  "name": "@codefly/marketing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/readiness.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "npm run quality",
    "quality": "tsx scripts/quality.ts && node scripts/check-boundaries.mjs",
    "budget": "node scripts/performance-budget.mjs",
    "readiness": "node scripts/readiness.mjs --report",
    "readiness:production": "node scripts/readiness.mjs --production",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
    "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
    "nanoid@>=3.0.0 <3.3.17": "3.3.17",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
