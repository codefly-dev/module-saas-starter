# Backend environment — copy to .env and fill in for local iteration,
# or set via your deploy platform's secret manager in production.

# Which validator to use at login time. Values:
#   dev    — DevValidator reads an explicitly selected fixture (local only)
#   workos — pkg/auth/oidc with WorkOSConfig preset
#   auth0  — pkg/auth/oidc with Auth0Config preset
#   google — pkg/auth/oidc with GoogleConfig preset
# Development auth is selected only by `codefly run --fixture <name>` in the
# Codefly local environment. Setting AUTH_PROVIDER=dev by itself fails closed.
# AUTH_PROVIDER=workos

# Exact comma-separated OAuth callback allowlist. Required whenever
# AUTH_PROVIDER is not dev. HTTP is accepted only for loopback development.
# OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:21931/auth/callback,https://app.example.com/auth/callback

# Exact comma-separated browser origins allowed to make credentialed REST or
# Connect requests directly. Wildcards, paths, userinfo, and `null` are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:21931

# First-super-admin bootstrap.
# On the first login of this email address (via ANY configured provider),
# the backend grants super_admin and stamps bootstrap_state. Subsequent
# logins (even of this same email) do NOT re-grant. Self-disarming.
# BOOTSTRAP_ADMIN_EMAIL=you@yourco.com

# ────────────────────────────────────────────────────────────────
# WorkOS
# ────────────────────────────────────────────────────────────────
# WORKOS_CLIENT_ID=client_01ABCDEF
# WORKOS_CLIENT_SECRET=sk_xxxxx
# Authorize + token endpoints are derived from the client id via the
# WorkOSConfig preset — override here only if you run a WorkOS-compatible
# tenant at a non-default URL.
# WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_01ABCDEF
# WORKOS_TOKEN_URL=https://api.workos.com/user_management/authenticate
# WORKOS_ISSUER=https://api.workos.com/user_management/client_01ABCDEF

# ────────────────────────────────────────────────────────────────
# Vault — holds the Ed25519 JWT signing key and the API-key pepper.
# In dev this is provided by the saas-starter/vault service.
# In production point this at your hosted Vault (or Infisical/Doppler/
# whatever; the key just needs to be readable).
# ────────────────────────────────────────────────────────────────
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=dev-vault-token
# Fetching the key over cleartext http is refused for non-loopback hosts, since
# the token and private key would travel unprotected. Set this only when the hop
# is protected out of band — e.g. an mTLS service mesh wraps it (in-cluster
# dev-vault with no TLS of its own).
# VAULT_ALLOW_INSECURE_HTTP=true

# ────────────────────────────────────────────────────────────────
# Session TTLs (optional, defaults in ed25519minter.Config)
# ────────────────────────────────────────────────────────────────
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=168h
# Maximum age of a successful MFA ceremony accepted by sensitive operations.
# Supplied by the Codefly `security` workspace configuration in normal runs.
MFA_STEP_UP_MAX_AGE=15m
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_DISPLAY_NAME=SaaS Starter
WEBAUTHN_RP_ORIGINS=http://localhost:21931,http://localhost:3000
# Shared only with trusted internal callers such as auth-sidecar. Internal RPCs
# fail closed when this is unset. Prefer the Codefly `internal-auth` secret
# configuration over setting this file directly.
CODEFLY_INTERNAL_TOKEN=
# Separate proof that forwarded identity headers came from auth-sidecar. This
# does not grant internal-RPC access and must not reuse CODEFLY_INTERNAL_TOKEN.
CODEFLY_GATEWAY_TOKEN=

# ────────────────────────────────────────────────────────────────
# Stripe billing
# ────────────────────────────────────────────────────────────────
# Enabling Stripe requires both secrets. APP_BASE_URL is an exact origin used
# to build server-owned checkout success/cancel and billing-portal return URLs.
# Production origins must use HTTPS; only loopback development may use HTTP.
# STRIPE_API_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# APP_BASE_URL=https://app.example.com
