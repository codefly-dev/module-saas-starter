# Backend environment — copy to .env and fill in for local iteration,
# or set via your deploy platform's secret manager in production.

# Which validator to use at login time. Values:
#   dev    — DevValidator reads the fixtures/dev-admin.yaml file (default)
#   workos — pkg/auth/oidc with WorkOSConfig preset
#   auth0  — pkg/auth/oidc with Auth0Config preset
#   google — pkg/auth/oidc with GoogleConfig preset
AUTH_PROVIDER=dev

# First-super-admin bootstrap.
# On the first login of this email address (via ANY configured provider),
# the backend grants super_admin and stamps bootstrap_state. Subsequent
# logins (even of this same email) do NOT re-grant. Self-disarming.
# BOOTSTRAP_ADMIN_EMAIL=you@yourco.com

# ────────────────────────────────────────────────────────────────
# WorkOS
# ────────────────────────────────────────────────────────────────
# WORKOS_CLIENT_ID=client_01ABCDEF
# WORKOS_CLIENT_SECRET=sk_xxxxx
# Authorize + token endpoints are derived from the client id via the
# WorkOSConfig preset — override here only if you run a WorkOS-compatible
# tenant at a non-default URL.
# WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_01ABCDEF
# WORKOS_TOKEN_URL=https://api.workos.com/user_management/authenticate
# WORKOS_ISSUER=https://api.workos.com/user_management/client_01ABCDEF

# ────────────────────────────────────────────────────────────────
# Vault — holds the Ed25519 JWT signing key and the API-key pepper.
# In dev this is provided by the saas-starter/vault service.
# In production point this at your hosted Vault (or Infisical/Doppler/
# whatever; the key just needs to be readable).
# ────────────────────────────────────────────────────────────────
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=dev-vault-token

# ────────────────────────────────────────────────────────────────
# Session TTLs (optional, defaults in ed25519minter.Config)
# ────────────────────────────────────────────────────────────────
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=168h
