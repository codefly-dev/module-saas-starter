# Local Codefly dogfood Temporal database only. Remote environments must use a
# secret provider and unique high-entropy credentials.
POSTGRES_USER=temporal
POSTGRES_PASSWORD=local-temporal-owner-password-change-me
POSTGRES_READ_ONLY_PASSWORD=local-temporal-read-only-password-change-me
POSTGRES_READ_WRITE_PASSWORD=local-temporal-read-write-password-change-me
