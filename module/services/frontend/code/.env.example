# Frontend environment — copy to .env.local and fill in.
# Values prefixed NEXT_PUBLIC_ are exposed to the browser; anything else
# is server-only.

# Browser API traffic is always relative and same-origin. For a standalone
# frontend server, Codefly injects these server-only binding destinations:
# API_REST_INTERNAL=http://accounts-rest.internal
# API_CONNECT_INTERNAL=http://accounts-connect.internal

# ────────────────────────────────────────────────────────────────
# OAuth providers — add one block per provider you want enabled.
# The login page shows a button for every provider that has both
# an AUTHORIZE_URL and a CLIENT_ID configured.
#
# Client SECRETS are NOT set here — they live on the backend only.
# ────────────────────────────────────────────────────────────────

# WorkOS (recommended for B2B SaaS)
# Create a WorkOS project at https://dashboard.workos.com and copy
# the Client ID. Redirect URI in the WorkOS dashboard must match
# {your-origin}/auth/callback.
# NEXT_PUBLIC_WORKOS_AUTHORIZE_URL=https://api.workos.com/user_management/authorize
# NEXT_PUBLIC_WORKOS_CLIENT_ID=client_01ABCDEF
# NEXT_PUBLIC_WORKOS_SCOPE=openid email profile

# Google Sign-In
# https://console.cloud.google.com/apis/credentials — OAuth 2.0 Client ID
# NEXT_PUBLIC_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_SCOPE=openid email profile

# Auth0
# https://manage.auth0.com/ — Applications → Regular Web Application
# NEXT_PUBLIC_AUTH0_AUTHORIZE_URL=https://your-tenant.auth0.com/authorize
# NEXT_PUBLIC_AUTH0_CLIENT_ID=xxxxxx
# NEXT_PUBLIC_AUTH0_SCOPE=openid email profile
