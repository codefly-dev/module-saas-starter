{
	"name": "@codefly/saas-settings",
	"version": "0.1.0",
	"description": "Schema-agnostic typed settings helpers for SaaS Starter frontends and plugins.",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts"
	},
	"devDependencies": {
		"typescript": "5.9.3",
		"vitest": "^3.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0"
}
