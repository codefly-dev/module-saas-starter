{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    // This package ships neither `src` nor `generated` (see the include note
    // below — shipping `generated` would leak the internal proto surfaces the
    // published-surface test forbids), so any map it emitted would name sources
    // absent from the tarball. Inlining them instead was measured at 513 kB of
    // embedded source text — 89% of all map bytes and 43% of the unpacked
    // package, paid by every solution that installs it, for frames most
    // consumers never open. Emitting no maps fixes the same defect and makes
    // the package 576 kB smaller. `target: ES2022` output stays close to source.
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // Only `src` is a compilation root. tsc still pulls in every generated file
  // these sources actually import — the `accounts` facade plus the reachable
  // `_pb` closure of the three public services — and emits it under `dist/`.
  // But the *unreachable* generated modules (the rest of the saas.accounts.v1
  // message graph and adjacent packages, including internal admin/authz/mfa/sso
  // surfaces) never enter the program, so they never reach the published tarball
  // (`files: ["dist"]`). Do NOT add `generated/**` here: the generator emits the
  // full package descriptor regardless of `--services`, so a wildcard include
  // force-emits that entire graph into `dist`. The `published-surface` test guards this.
  "include": ["src/**/*.ts"]
}
