{
	"name": "@codefly-dev/saas-sdk",
	"version": "0.2.3",
	"description": "Typed Connect client, gateway-bound facades, and audit data-graph tooling for the saas-starter public API.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codefly-dev/module-saas-starter.git",
		"directory": "module/services/frontend/code/packages/saas-sdk"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js",
			"default": "./dist/src/index.js"
		},
		"./chat": {
			"types": "./dist/src/chat/index.d.ts",
			"import": "./dist/src/chat/index.js",
			"default": "./dist/src/chat/index.js"
		}
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
		"generate": "codefly generate client --from contracts:../../../../../contracts/api --endpoint accounts/connect --language typescript --services AccessibleScopeService,AuditService,DatasourceService,WebhookService --name saas-sdk --npm-scope @codefly-dev/saas-sdk --module-name accounts --output ./generated",
		"test": "vitest run --config vitest.config.ts"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.11.0",
		"@connectrpc/connect": "^2.1.1"
	},
	"peerDependencies": {
		"react": ">=19.2 <20"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@testing-library/react": "^16.1.0",
		"@types/react": "19.2.17",
		"happy-dom": "^20.8.9",
		"react": "^19.2.8",
		"typescript": "5.9.3",
		"vitest": "^3.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0"
}
