{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://codefly.dev/schema/plugin.codefly.v1.json",
	"title": "plugin.codefly.yaml",
	"description": "Unified Codefly plugin manifest spanning backend services, API compatibility, events, frontend contributions, required platform capabilities, permissions, entitlements, configuration, migrations, egress, lifecycle, and integrity. The identity/services/api/events/ui/needs/permissions/lifecycle facts project onto obin's lodestar SolutionSpec.",
	"type": "object",
	"additionalProperties": false,
	"required": ["apiVersion", "kind", "metadata"],
	"properties": {
		"apiVersion": { "const": "plugin.codefly.dev/v1" },
		"kind": { "const": "Plugin" },
		"metadata": { "$ref": "#/$defs/identity" },
		"services": {
			"type": "array",
			"items": { "$ref": "#/$defs/service" }
		},
		"api": { "$ref": "#/$defs/api" },
		"events": { "$ref": "#/$defs/events" },
		"ui": { "$ref": "#/$defs/ui" },
		"dashboard": { "$ref": "#/$defs/dashboard" },
		"needs": {
			"type": "array",
			"items": { "$ref": "#/$defs/need" }
		},
		"permissions": {
			"type": "array",
			"items": { "$ref": "#/$defs/permission" }
		},
		"entitlements": {
			"type": "array",
			"items": { "$ref": "#/$defs/entitlement" }
		},
		"config": {
			"type": "array",
			"items": { "$ref": "#/$defs/configKey" }
		},
		"migrations": {
			"type": "array",
			"items": { "$ref": "#/$defs/migration" }
		},
		"egress": {
			"type": "array",
			"items": { "$ref": "#/$defs/egress" }
		},
		"lifecycle": { "$ref": "#/$defs/lifecycle" },
		"integrity": { "$ref": "#/$defs/integrity" }
	},
	"$defs": {
		"logicalId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
		},
		"namespacedId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9._-]*(?::[a-z][a-z0-9._-]*)*$"
		},
		"eventType": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)*\\.v[1-9][0-9]*$"
		},
		"protocol": { "enum": ["connect", "rest", "grpc"] },
		"protocols": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "$ref": "#/$defs/protocol" }
		},
		"description": { "type": "string", "minLength": 1 },
		"major": { "type": "integer", "minimum": 1 },
		"identity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "version"],
			"properties": {
				"name": { "$ref": "#/$defs/logicalId" },
				"version": {
					"type": "string",
					"pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
				},
				"displayName": { "type": "string", "minLength": 1 },
				"description": { "$ref": "#/$defs/description" },
				"publisher": {
					"type": "string",
					"pattern": "^(?:[a-z0-9-]+\\.)+[a-z]{2,}$"
				}
			}
		},
		"service": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "endpoints"],
			"properties": {
				"name": { "$ref": "#/$defs/logicalId" },
				"description": { "$ref": "#/$defs/description" },
				"endpoints": { "$ref": "#/$defs/protocols" }
			}
		},
		"api": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"exposes": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["contract", "major", "protocols"],
						"properties": {
							"contract": { "$ref": "#/$defs/logicalId" },
							"major": { "$ref": "#/$defs/major" },
							"protocols": { "$ref": "#/$defs/protocols" }
						}
					}
				},
				"consumes": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["contract", "major"],
						"properties": {
							"contract": { "$ref": "#/$defs/logicalId" },
							"major": { "$ref": "#/$defs/major" },
							"alias": { "$ref": "#/$defs/logicalId" }
						}
					}
				}
			}
		},
		"events": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"publishes": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["type"],
						"properties": {
							"type": { "$ref": "#/$defs/eventType" },
							"description": { "$ref": "#/$defs/description" }
						}
					}
				},
				"subscribes": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["type", "handler"],
						"properties": {
							"type": { "$ref": "#/$defs/eventType" },
							"handler": { "$ref": "#/$defs/logicalId" },
							"description": { "$ref": "#/$defs/description" }
						}
					}
				}
			}
		},
		"ui": {
			"type": "object",
			"additionalProperties": false,
			"description": "Frontend contribution block validated by @codefly/saas-plugin-contract. The plugin's identity supplies the contract version and name.",
			"properties": {
				"navigation": { "type": "object" },
				"navItems": { "type": "array" },
				"routes": { "type": "array" },
				"widgets": { "type": "array" },
				"services": { "type": "array" }
			}
		},
		"dashboard": {
			"type": "object",
			"additionalProperties": false,
			"required": ["events", "metrics", "dashboards"],
			"description": "Data-graph declaration: named audit events, metrics computed over them, and dashboards binding widgets to metrics. Cross-references (a metric's event, a derived metric's inputs, a widget's metric) and the acyclicity of derived metrics are enforced by the host validator, not this schema.",
			"properties": {
				"events": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["name", "type"],
						"properties": {
							"name": { "$ref": "#/$defs/logicalId" },
							"type": { "$ref": "#/$defs/eventType" },
							"description": { "$ref": "#/$defs/description" }
						}
					}
				},
				"metrics": {
					"type": "array",
					"items": {
						"oneOf": [
							{
								"type": "object",
								"additionalProperties": false,
								"required": ["id", "kind", "filter", "groupBy", "aggregation"],
								"properties": {
									"id": { "$ref": "#/$defs/logicalId" },
									"kind": { "const": "source" },
									"title": { "$ref": "#/$defs/description" },
									"description": { "$ref": "#/$defs/description" },
									"filter": {
										"type": "object",
										"additionalProperties": false,
										"required": ["event"],
										"properties": {
											"event": { "$ref": "#/$defs/logicalId" },
											"actor": { "type": "string", "minLength": 1 },
											"resource": { "type": "string", "minLength": 1 }
										}
									},
									"groupBy": {
										"enum": ["event_type", "category", "actor", "time"]
									},
									"bucket": { "enum": ["day", "week", "month"] },
									"aggregation": { "enum": ["count", "count_distinct"] }
								}
							},
							{
								"type": "object",
								"additionalProperties": false,
								"required": ["id", "kind", "operation", "inputs"],
								"properties": {
									"id": { "$ref": "#/$defs/logicalId" },
									"kind": { "const": "derived" },
									"title": { "$ref": "#/$defs/description" },
									"description": { "$ref": "#/$defs/description" },
									"operation": { "enum": ["sum", "ratio", "difference"] },
									"inputs": {
										"type": "array",
										"minItems": 2,
										"items": { "$ref": "#/$defs/logicalId" }
									}
								}
							}
						]
					}
				},
				"dashboards": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "layout", "widgets"],
						"properties": {
							"id": { "$ref": "#/$defs/logicalId" },
							"title": { "$ref": "#/$defs/description" },
							"layout": { "enum": ["grid", "stack"] },
							"widgets": {
								"type": "array",
								"minItems": 1,
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": ["id", "metric", "visualization"],
									"properties": {
										"id": { "$ref": "#/$defs/logicalId" },
										"metric": { "$ref": "#/$defs/logicalId" },
										"visualization": {
											"enum": ["line", "bar", "area", "number", "table"]
										},
										"title": { "$ref": "#/$defs/description" }
									}
								}
							}
						}
					}
				}
			}
		},
		"need": {
			"type": "object",
			"additionalProperties": false,
			"required": ["capability"],
			"properties": {
				"capability": { "$ref": "#/$defs/namespacedId" },
				"optionality": { "enum": ["required", "optional"] }
			}
		},
		"permission": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id"],
			"properties": {
				"id": { "$ref": "#/$defs/namespacedId" },
				"description": { "$ref": "#/$defs/description" }
			}
		},
		"entitlement": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id"],
			"properties": {
				"id": { "$ref": "#/$defs/namespacedId" },
				"description": { "$ref": "#/$defs/description" },
				"defaultGranted": { "type": "boolean" }
			}
		},
		"configKey": {
			"type": "object",
			"additionalProperties": false,
			"required": ["key", "type"],
			"properties": {
				"key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
				"type": { "enum": ["string", "int", "bool", "duration", "url"] },
				"required": { "type": "boolean" },
				"secret": { "type": "boolean" },
				"default": { "type": ["string", "number", "boolean"] },
				"description": { "$ref": "#/$defs/description" }
			}
		},
		"migration": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "scope"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^\\d{4}_[a-z0-9]+(?:_[a-z0-9]+)*$"
				},
				"scope": { "enum": ["shared", "tenant"] },
				"description": { "$ref": "#/$defs/description" }
			}
		},
		"egress": {
			"type": "object",
			"additionalProperties": false,
			"required": ["host"],
			"properties": {
				"host": {
					"type": "string",
					"pattern": "^(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$"
				},
				"ports": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "integer", "minimum": 1, "maximum": 65535 }
				},
				"description": { "$ref": "#/$defs/description" }
			}
		},
		"lifecycleStep": {
			"type": "object",
			"additionalProperties": false,
			"required": ["job"],
			"properties": {
				"job": { "$ref": "#/$defs/logicalId" },
				"description": { "$ref": "#/$defs/description" }
			}
		},
		"lifecycle": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"install": {
					"type": "array",
					"items": { "$ref": "#/$defs/lifecycleStep" }
				},
				"upgrade": {
					"type": "array",
					"items": { "$ref": "#/$defs/lifecycleStep" }
				},
				"uninstall": {
					"type": "array",
					"items": { "$ref": "#/$defs/lifecycleStep" }
				}
			}
		},
		"integrity": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"signature": {
					"type": "object",
					"additionalProperties": false,
					"required": ["algorithm", "keyId", "value"],
					"properties": {
						"algorithm": { "type": "string", "minLength": 1 },
						"keyId": { "type": "string", "minLength": 1 },
						"value": { "type": "string", "minLength": 1 }
					}
				},
				"artifacts": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["path", "sha256"],
						"properties": {
							"path": { "type": "string", "minLength": 1 },
							"sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
						}
					}
				}
			}
		}
	}
}
