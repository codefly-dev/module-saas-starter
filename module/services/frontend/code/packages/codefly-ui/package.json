{
	"name": "@codefly/ui",
	"version": "0.1.0",
	"description": "The shared, versioned Codefly SaaS frontend kit: the plugin host and the tokens-as-data skin mechanism, standalone so the host and Module-Federation remotes import and dedupe one copy.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codefly-dev/module-saas-starter.git",
		"directory": "module/services/frontend/code/packages/codefly-ui"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./plugin-host": {
			"types": "./dist/plugin-host/index.d.ts",
			"import": "./dist/plugin-host/index.js",
			"default": "./dist/plugin-host/index.js"
		},
		"./plugin-host/runtime": {
			"types": "./dist/plugin-host/runtime.d.ts",
			"import": "./dist/plugin-host/runtime.js",
			"default": "./dist/plugin-host/runtime.js"
		},
		"./plugin-host/ui": {
			"types": "./dist/plugin-host/ui.d.ts",
			"import": "./dist/plugin-host/ui.js",
			"default": "./dist/plugin-host/ui.js"
		},
		"./skin": {
			"types": "./dist/skin/index.d.ts",
			"import": "./dist/skin/index.js",
			"default": "./dist/skin/index.js"
		},
		"./dashboard": {
			"types": "./dist/dashboard/index.d.ts",
			"import": "./dist/dashboard/index.js",
			"default": "./dist/dashboard/index.js"
		},
		"./layout": {
			"types": "./dist/layout/index.d.ts",
			"import": "./dist/layout/index.js",
			"default": "./dist/layout/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts"
	},
	"peerDependencies": {
		"@codefly/saas-plugin-contract": "2.1.0",
		"@codefly/saas-plugin-react": "0.4.1",
		"react": ">=19.2 <20"
	},
	"peerDependenciesMeta": {
		"@codefly/saas-plugin-contract": {
			"optional": true
		},
		"@codefly/saas-plugin-react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@codefly/saas-plugin-contract": "2.1.0",
		"@codefly/saas-plugin-react": "0.4.1",
		"@testing-library/react": "^16.1.0",
		"@types/react": "19.2.17",
		"happy-dom": "^20.8.9",
		"react": "^19.2.8",
		"typescript": "5.9.3",
		"vitest": "^3.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0"
}
