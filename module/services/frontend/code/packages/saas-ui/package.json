{
	"name": "@codefly-dev/saas-ui",
	"version": "0.3.0",
	"description": "Reusable SaaS-domain frontend components (datasources, \u2026) the portal and solutions both import, built on @codefly-dev/ui primitives and driven by an injected typed client.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codefly-dev/module-saas-starter.git",
		"directory": "module/services/frontend/code/packages/saas-ui"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"!src/**/__tests__/**",
		"!src/**/*.test.*",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run --config vitest.config.ts"
	},
	"peerDependencies": {
		"@bufbuild/protobuf": ">=2",
		"@codefly-dev/saas-sdk": "^0.2.3",
		"@connectrpc/connect": ">=2",
		"@connectrpc/connect-web": ">=2",
		"@hookform/resolvers": ">=3",
		"@tanstack/react-query": ">=5",
		"react": ">=19.2 <20",
		"react-hook-form": ">=7",
		"zod": ">=3",
		"@codefly-dev/ui": "^0.3.0"
	},
	"devDependencies": {
		"@bufbuild/protobuf": "^2.11.0",
		"@codefly-dev/saas-sdk": "^0.2.3",
		"@connectrpc/connect": "^2.1.1",
		"@connectrpc/connect-web": "^2.1.1",
		"@hookform/resolvers": "^3.9.0",
		"@tanstack/react-query": "^5.60.0",
		"@testing-library/react": "^16.1.0",
		"@types/react": "19.2.17",
		"happy-dom": "^20.8.9",
		"react": "^19.2.8",
		"react-hook-form": "^7.54.0",
		"typescript": "5.9.3",
		"vitest": "^3.0.0",
		"zod": "^3.24.0",
		"@codefly-dev/ui": "^0.3.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0"
}
