{
	"name": "admin-dashboard",
	"version": "0.0.1",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build:plugin-contract": "npm run build --workspace @codefly/saas-plugin-contract",
		"build:plugin-react": "npm run build --workspace @codefly/saas-plugin-react",
		"build:plugin-packages": "node scripts/build-plugin-workspaces.mjs",
		"generate:plugin-capability-proto": "cd packages/saas-plugin-contract && codefly generate proto --proto ./proto --output . --local --template buf.gen.local.yaml",
		"prepare:frontend": "npm run build:plugin-packages && tsx scripts/generate-plugin-service-allowlist.ts && tsx scripts/check-plugin-service-dependencies.ts",
		"generate:plugin-allowlist": "npm run build:plugin-packages && tsx scripts/generate-plugin-service-allowlist.ts",
		"check:plugin-allowlist": "npm run build:plugin-packages && tsx scripts/generate-plugin-service-allowlist.ts --check",
		"generate:plugin-codefly-dependencies": "npm run generate:plugin-allowlist && cd ../../accounts/code && go run ./cmd/frontend-service-manifest -catalog ../generated/service-catalog.json -topology ../../../deployment/topology.bindings.codefly.yaml -allowlist ../../frontend/code/server/plugin-service-allowlist.generated.json -output ../../frontend/service.codefly.yaml",
		"check:plugin-codefly-dependencies": "npm run check:plugin-allowlist && tsx scripts/check-plugin-service-dependencies.ts",
		"dev": "npm run prepare:frontend && NODE_OPTIONS=\"$NODE_OPTIONS --max-old-space-size=8192\" next dev",
		"build": "npm run prepare:frontend && next build",
		"start": "next start",
		"lint": "npm run build:plugin-packages && eslint",
		"format": "biome format --write .",
		"fix": "biome check --write .",
		"test": "npm run prepare:frontend && vitest run",
		"test:pure": "npm run prepare:frontend && vitest run --project pure",
		"test:integration": "npm run prepare:frontend && vitest run --project pipeline",
		"test:plugin-contract": "npm run test --workspace @codefly/saas-plugin-contract",
		"test:plugin-react": "npm run test --workspace @codefly/saas-plugin-react",
		"typecheck": "npm run build:plugin-packages && tsc --noEmit",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@bufbuild/protobuf": "^2.11.0",
		"@codefly/saas-plugin-contract": "2.1.0",
		"@codefly/saas-plugin-react": "0.4.1",
		"@codefly/saas-settings": "0.1.0",
		"@connectrpc/connect": "^2.1.1",
		"@connectrpc/connect-web": "^2.1.1",
		"@hookform/resolvers": "^3.9.0",
		"@sentry/nextjs": "^10.50.0",
		"@simplewebauthn/browser": "^13.3.0",
		"@tanstack/react-query": "^5.60.0",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"codefly": "https://github.com/codefly-dev/sdk-js/archive/9f3bb78682a0c2b9a70631d35c2ae0094c281ac5.tar.gz",
		"js-yaml": "^4.1.1",
		"lucide-react": "^1.8.0",
		"next": "^16.2.12",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.54.0",
		"server-only": "^0.0.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^3.24.0",
		"zustand": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@bufbuild/protoc-gen-es": "2.11.0",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.1.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "20.19.39",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.2.12",
		"happy-dom": "^20.8.9",
		"jsdom": "^29.0.2",
		"msw": "^2.7.0",
		"tailwindcss": "^4",
		"tsx": "4.23.1",
		"typescript": "5.9.3",
		"vitest": "^3.0.0"
	},
	"overrides": {
		"brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
		"fast-uri@>=3.0.0 <3.1.5": "3.1.5",
		"postcss": "8.5.19",
		"sharp": "0.35.3"
	}
}
