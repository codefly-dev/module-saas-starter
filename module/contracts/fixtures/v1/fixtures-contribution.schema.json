{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codefly.dev/schemas/saas/fixtures-contribution-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "namespace", "fixtures"],
  "properties": {
    "schema": {"const": "codefly/saas/fixtures-contribution/v1"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"},
          "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.ya?ml$"}
        }
      }
    }
  }
}
