# Legal content for the browser (Terms of Service + Privacy Policy).
#
# The frontend consumes this Codefly workspace configuration group; the nextjs
# agent exposes these NEXT_PUBLIC_* values to the browser bundle. Only the
# NEXT_PUBLIC_ keys exist because legal content is purely browser-rendered
# (src/lib/legal-config.ts).
#
# Left empty on purpose for the local fixture stack: running under a fixture
# (`codefly run service --fixture ...`) enables the dev placeholder path in
# next.config.mjs, which fills any blank field with a clearly non-binding
# placeholder. Set real values in local-dogfood / per-environment config to
# satisfy the terms gate without the fixture.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_TERMS_CONTENT=
NEXT_PUBLIC_LEGAL_PRIVACY_CONTENT=
