PRODUCT_ANALYTICS_MODE=disabled
NEXT_PUBLIC_PRODUCT_ANALYTICS_MODE=disabled

# The browser capture target and its public project key. Both are public by
# design (the browser receives them) and empty here, so local runs capture
# nothing. Declared so a deployment can supply them: the frontend has read both
# all along, and a key no group declares is never delivered.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
