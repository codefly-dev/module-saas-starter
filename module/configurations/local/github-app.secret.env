# The GitHub App's RSA signing key (PKCS#1 or PKCS#8 PEM), the credential every
# installation token is minted from.
#
# This is deployment custody, never source custody: it is read only by accounts,
# is never copied onto a source record, and is never handed to a consuming
# module or a browser. A real key is supplied through Codefly's secret
# configuration provider; what ships here is a placeholder, and an App is only
# registered once GITHUB_APP_ID is also set.
GITHUB_APP_PRIVATE_KEY=local-dev-only-replace-me

# The webhook secret set on that same App registration. GitHub signs every
# delivery to the App with it. Those deliveries are App-wide, so this secret is
# too: a GitHub App has exactly one webhook URL and one webhook secret, neither
# of which can vary per installation or per repository the way a source's own
# push secret does.
#
# The registration's single webhook URL must point at
# `/v1/datasource/github/app/webhook` on this deployment's public ingress, and
# the registration must subscribe to three events:
#
#   installation               — installed/deleted/suspended/unsuspended
#   installation_repositories  — the repository selection a tenant edits
#   push                       — content changes on a connected repository
#
# The first two are App-availability events and can arrive nowhere else. `push`
# is here because an App-backed source authenticates through the installation
# and has no push secret of its own, so this endpoint is the only one that can
# verify its pushes. Without the `push` subscription an App-backed source still
# syncs, but only on "Sync now" and the periodic reconcile — correct, just no
# longer near-live.
#
# The App-level receiver is only mounted once a real App is registered
# (GITHUB_APP_ID and the signing key), so the placeholder here never admits an
# endpoint on its own.
GITHUB_APP_WEBHOOK_SECRET=local-dev-only-replace-me

# The App's OAuth client secret, paired with GITHUB_APP_CLIENT_ID. Tenant
# onboarding trades the setup redirect's authorization code for a user-to-server
# token with it, which is the only thing that attributes an installation to the
# person who installed it. Deployment custody like the signing key above: read
# only by accounts, never copied onto a source and never handed to a browser.
GITHUB_APP_CLIENT_SECRET=local-dev-only-replace-me
