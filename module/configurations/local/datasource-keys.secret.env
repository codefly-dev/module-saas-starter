# The message-authentication keys the datasource paths sign with, one per purpose.
#
# The invariant (SP-SEC-07): each signing or message-authentication purpose has its
# own key, derived from no credential shared beyond its owner. These are DELIVERED
# per purpose rather than derived from a shared credential, so rotating one rotates
# one thing.
#
# Unset leaves the purpose it serves unavailable rather than falling back to a
# derivation, because a fallback would make the property conditional on nobody
# forgetting. Provision both on every cell.

# Signs the opaque content tickets a change-set job carries in place of an
# oversized blob. The same value must be present wherever a ticket is redeemed.
DATASOURCE_CONTENT_TICKET_KEY=local-dev-only-replace-me

# Signs the account-link state that carries a person through a provider's sign-in
# and back. Domain-separated from the ticket key above, so neither token can pass
# for the other.
DATASOURCE_ACCOUNT_LINK_KEY=local-dev-only-replace-me
