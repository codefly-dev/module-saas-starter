# The ordinary local profile uses a Codefly-selected fixture for identity.
# The fixture name is data only; this configuration selects the authentication
# adapter explicitly. Real-provider dogfooding uses the dogfood profile.
IDENTITY_PROVIDER=fixture

# IDENTITY_SIGNUP_MODE gates signup only; login and invite are never gated.
#   open     — any authenticated identity may sign up (default)
#   invite   — signup requires a pending invitation for the verified email
#   waitlist — signup requires an approved or invited waitlist entry
# Unrecognised values fail startup closed.
IDENTITY_SIGNUP_MODE=open

# IDENTITY_REGISTERED_CLIENTS declares the first-party clients allowed to sign
# people in through this host's own login page — an add-in, a CLI, a mobile app.
# A JSON array of
#   {client_id, name, kind: "public", redirect_uris: [...], origins: [...]}
# where redirect_uris are the exact absolute URIs an authorization code may be
# delivered to, and origins the exact scheme://host[:port] values the client
# calls from. Both are matched exactly: no wildcards, no prefixes.
#
# Unset means no client is registered, which refuses the flow. This module names
# no specific client; a deployment declares its own.
IDENTITY_REGISTERED_CLIENTS=

# IDENTITY_CLIENT_METADATA_DOCUMENTS admits clients that register themselves by
# publishing a Client ID Metadata Document at an https client_id URL — the
# mechanism the MCP specification prefers, and the one an MCP client (Claude
# Code, Claude Desktop, a Claude.ai connector) uses. The host fetches the
# document, validates it, and writes nothing durable: there is no row, no admin
# surface, and no state outliving the authorization request.
#
#   (unset)       — refused. Only IDENTITY_REGISTERED_CLIENTS may sign anyone in.
#   any           — any client_id URL whose document validates.
#   <url>,<url>   — only these exact client_id URLs.
#
# Unset is the default for the same reason an unset client registry registers
# nobody: a deployment that configured nothing must not be admitting clients it
# never decided to admit. Whether to enable it is a deployment decision, not a
# per-organisation one; see the handbook's decisions/registered-clients.md.
IDENTITY_CLIENT_METADATA_DOCUMENTS=
