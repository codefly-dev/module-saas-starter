# How this service reaches the Vault that holds the host's Ed25519 signing key
# and the Transit key that seals its secrets.
#
# accounts refuses cleartext http to a non-loopback Vault for every request —
# the signing-key fetch and every Transit call alike: the Vault token, the
# private key and the values Transit seals would otherwise cross the wire in the
# clear. Loopback is always allowed, so a local run needs no opt-in and this
# default stays false.
#
# This is a LOCAL assertion only. Outside the local environment accounts refuses
# VAULT_ALLOW_INSECURE_HTTP=true by name: a mesh wrapping the hop is something
# nothing in the address can prove, and it is not a substitute for TLS to the
# Vault that holds the signing key.
VAULT_ALLOW_INSECURE_HTTP=false

# Which Vault, and how accounts authenticates to it.
#
# Locally, accounts uses the composed `vault` service's projection: its address,
# and a token (or a token file) the platform provisions.
#
# OUTSIDE THE LOCAL ENVIRONMENT that projection is never inherited. The cell
# names its own Vault here, and accounts logs in as its own ServiceAccount:
#
#   VAULT_ADDR           https URL of the Vault. REQUIRED outside local —
#                        empty there is refused by name rather than falling back
#                        to the composed `vault` service, which is the
#                        local-development shape.
#   VAULT_CA_FILE        absolute path to the PEM CA the Vault's certificate
#                        chains to; required with kubernetes auth off loopback.
#                        Outside the local environment this DEFAULTS to the
#                        path this module's own render mounts the `vault-ca`
#                        ConfigMap's `ca.crt` at, /etc/vault/ca/ca.crt, so a
#                        cell sets it only when it mounts the CA elsewhere.
#   VAULT_AUTH_METHOD    `token` (local only) or `kubernetes`. A token binding
#                        outside local is refused by name: a long-lived Vault
#                        token provisioned to the pod is the same credential for
#                        every replica and outlives the pod that read it.
#   VAULT_K8S_ROLE       the Vault role bound to accounts' ServiceAccount;
#                        required with kubernetes auth, with no default.
#   VAULT_K8S_MOUNT      the auth method's mount path; default `kubernetes`.
#   VAULT_K8S_TOKEN_PATH absolute path of a projected ServiceAccount token whose
#                        audience is `vault`; default /var/run/secrets/vault/token,
#                        which is where this module's own render projects it.
#                        NOT the pod's default token: that one is audience-bound
#                        to the API server and must not be replayable against
#                        Vault.
#
# Which side owns which key. A cell's coordinate contract emits only the facts
# nobody else has — the address, the auth method, the auth mount and the role.
# The two in-pod paths belong to the host render itself, so they default here
# and the contract never has to copy them out of this repository:
#
#   the cell emits:    VAULT_ADDR  VAULT_AUTH_METHOD  VAULT_K8S_MOUNT  VAULT_K8S_ROLE
#   the host renders:  VAULT_CA_FILE  VAULT_K8S_TOKEN_PATH   (both defaulted)
#
# With kubernetes auth accounts logs in with that projected token, keeps the
# Vault token it receives in memory only, renews it before its lease runs out,
# and logs in again when renewal fails or Vault refuses it. It never reads a
# static or root token in that mode, and no Vault token is projected to the pod
# at all.
#
# The Vault role needs exactly: read on secret/data/jwt-signing-key, and
# encrypt/decrypt/hmac on transit/keys/api-keys. The signing key's custody is
# the cell's identity-seeding command, never accounts — see
# module/KEY_ROTATION.md, "Custody of the signing key".
VAULT_ADDR=
VAULT_CA_FILE=
VAULT_AUTH_METHOD=token
VAULT_K8S_ROLE=
VAULT_K8S_MOUNT=
VAULT_K8S_TOKEN_PATH=

# The command the cell uses to seed secret/data/jwt-signing-key from its durable
# identity seed, as free text. accounts quotes it verbatim — collapsed to one
# line and bounded to 200 characters — in the refusal it raises when the signing
# key is missing, so the operator reading a crash loop sees the command to run.
#
# This module never names that command itself: a module names nothing above it,
# and the verb belongs to the cell's runbook. Left empty the refusal points at
# module/KEY_ROTATION.md instead. Never put a credential here.
VAULT_KEY_CUSTODY=
