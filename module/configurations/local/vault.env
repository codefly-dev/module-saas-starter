# How this service reaches the Vault that holds the host's Ed25519 signing key
# and the Transit key that seals its secrets.
#
# accounts refuses cleartext http to a non-loopback Vault for every request —
# the signing-key fetch and every Transit call alike: the Vault token, the
# private key and the values Transit seals would otherwise cross the wire in the
# clear. Loopback is always allowed, so a local run needs no opt-in and this
# default stays false.
#
# A deployed cell that reaches Vault over http from another pod must set this to
# true, and doing so is the operator's explicit assertion that the hop is
# protected out of band — an mTLS service mesh wrapping it, for example. It is
# an assertion precisely because nothing in the address can prove it; a cell
# that terminates TLS on Vault itself should leave this false and use https.
VAULT_ALLOW_INSECURE_HTTP=false

# Which Vault, and how accounts authenticates to it.
#
# By default accounts uses the composed `vault` service's projection: its
# address, and a token (or a token file) the platform provisions. A deployment
# that runs its own Vault names it here instead, and should let accounts log in
# itself rather than provision it any Vault token:
#
#   VAULT_ADDR           https URL of the Vault; empty uses the composed service.
#   VAULT_CA_FILE        absolute path to the PEM CA the Vault's certificate
#                        chains to; required with kubernetes auth off loopback.
#   VAULT_AUTH_METHOD    `token` (default) or `kubernetes`.
#   VAULT_K8S_ROLE       the Vault role bound to accounts' ServiceAccount;
#                        required with kubernetes auth.
#   VAULT_K8S_MOUNT      the auth method's mount path; default `kubernetes`.
#   VAULT_K8S_TOKEN_PATH absolute path of a projected ServiceAccount token whose
#                        audience is `vault`; default /var/run/secrets/vault/token.
#
# With kubernetes auth accounts logs in with that projected token, keeps the
# Vault token it receives in memory only, renews it before its lease runs out,
# and logs in again when renewal fails or Vault refuses it. It never reads a
# static or root token in that mode, and it refuses plaintext http and an
# unpinned CA anywhere but loopback, whatever VAULT_ALLOW_INSECURE_HTTP says.
VAULT_ADDR=
VAULT_CA_FILE=
VAULT_AUTH_METHOD=token
VAULT_K8S_ROLE=
VAULT_K8S_MOUNT=
VAULT_K8S_TOKEN_PATH=
