# APP_BASE_URL is the one origin this deployment treats as its own: what binds an
# OAuth redirect, the authenticator relying-party origin, every emailed link, and
# the frontend solution proxy's same-origin judgement.
#
# It is OPERATOR configuration, and nothing in a request can establish it. This one
# value is what binds an OAuth redirect, the authenticator relying-party origin, the
# solution proxy's same-origin comparison and every emailed link, so a deployed cell
# that has not set it refuses those rather than resolving an origin some other way.
#
# A DEPLOYED runtime therefore requires it: accounts refuses to start without it,
# and the frontend refuses to serve sign-in or the solution proxy. Local
# development pins no runtime port, so it is empty here and the frontend uses its
# own discovered loopback endpoint, which is the host the browser reaches anyway.
APP_BASE_URL=

# Interactive links use the origin above. A background-only production origin may
# be supplied by deployment configuration.
BOOTSTRAP_ADMIN_EMAIL=

# APP_BASE_URL is this host's own public origin, and since issue #1003 it is
# also its OAuth 2.1 issuer: the `iss` of every access token AND the `issuer` of
# the RFC 8414 document published at
# <APP_BASE_URL>/.well-known/oauth-authorization-server. RFC 8414 §2 requires
# the issuer to be an https URL, so the two can only be equal if this is set —
# a client that discovers the metadata and then verifies `iss` against it
# refuses a token naming anything else.
#
# Unset (the default here) means no metadata is published and tokens keep the
# pre-metadata literal issuer, so the two cannot disagree. A deployment that
# wants an MCP client to discover it MUST set this; the gateway reads the same
# value to publish a solution's protected-resource metadata and to require a
# token's resource audience to name this host.
APP_BASE_URL=
