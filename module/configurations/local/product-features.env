# What this deployment's product presents. The frontend reads this group per
# request through the Codefly SDK and hands it to the browser, so a deployed
# image picks up the environment it runs in; nothing here is inlined at build
# time, and the NEXT_PUBLIC_ prefix is kept only so an existing group keeps
# working.
#
# The three switches show or hide optional product surfaces (Subscriptions,
# Single Sign-On, Entitlements). They are presentation, never authorization: a
# switch grants no entitlement and bypasses no permission. See PRODUCT_FEATURES.md.
NEXT_PUBLIC_ENABLE_SUBSCRIPTIONS=false
NEXT_PUBLIC_ENABLE_SSO=false
NEXT_PUBLIC_ENABLE_ENTITLEMENTS=false
# The permission resource type collection content is governed by, as the
# composition declares it — the same noun a module lists under `resources` in
# MODULE_PRINCIPALS (module-capabilities group). The host holds no domain
# content and has no noun of its own, so empty means undeclared: the Data
# sources page then reports that read access cannot be resolved, rather than
# claiming nobody holds it.
NEXT_PUBLIC_COLLECTION_CONTENT_RESOURCE=
