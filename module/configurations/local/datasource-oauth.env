# Deployment-wide provider descriptors, keyed by connector (e.g. api).
# {"api":{"authorize_url":"https://auth.example.com/authorize","token_url":"https://auth.example.com/token","scopes":["read","offline_access"]}}
providers={}
# Public app identifiers keyed by the same connector. Empty disables linking.
client_id={}
# Local runtime only: loopback ip:port entries a callable source may dial, so a
# host booted on a developer's machine can reach a stub provider beside it.
# e.g. 127.0.0.1:18080,[::1]:18081. Empty by default; any value refuses startup
# outside a local runtime (module/CALLABLE_SOURCES.md, "Local egress").
local_egress=
