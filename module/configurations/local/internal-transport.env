# Whether every in-cluster hop is carried by a mutually authenticated mesh.
#
# Some hops carry material that must not cross a network in the clear — the
# AppRole credential accounts logs in to Vault with, the Ed25519 signing key it
# reads, and every value Transit seals. Each refuses a plaintext routable
# address by default.
#
# Inside a cell there is often no https URL to give: transport security there is
# the mesh's (Istio ambient's ztunnel, for example), not each service's, so the
# peer listens in-mesh without a certificate of its own. A hostname cannot
# settle it — ".svc" says nothing about whether a mesh wraps the wire, and
# `vault.svc.example.com` is externally routable despite the label — and a
# silent allowance would not be reviewable. So the composition states it out
# loud and can be held to it.
#
# Fail-closed on two counts. Only the exact value `true` asserts the mesh;
# unset, empty and `false` keep plaintext refused; any other value FAILS
# STARTUP rather than being read as either answer, because a misspelled
# assertion must not pass for an absent one nor for a present one. And the
# assertion admits only what a mesh can cover: an in-cluster Kubernetes Service
# address (<service>.<namespace>.svc, optionally with the cluster domain). A
# plaintext URL to any other host stays refused with it set.
#
# Loopback is always allowed and needs no assertion, which is why a local run
# leaves this false.
#
# The group name (this file's stem) and the key map to the variable the SDK
# reads: CODEFLY__WORKSPACE_CONFIGURATION__INTERNAL_TRANSPORT__MESH_PROTECTED.
# The composed modules read the same group and key for their own in-cluster
# hops, so a cell asserts it once.
mesh-protected=false
