# Comma-separated exact IPs or CIDRs allowed to supply X-Forwarded-For and
# X-Real-IP. Empty means the gateway trusts no forwarding headers.
TRUSTED_PROXY_CIDRS=

# Explicit opt-in for registered /v1/<prefix> routes accepting signed Work
# Contexts without a bearer. Enable only targets that independently enforce
# Work Context scopes and current authority. Empty array keeps bearer-only access.
WORK_CONTEXT_MODULE_PREFIXES=[]
