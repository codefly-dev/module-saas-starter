ERROR_TRACKING_MODE=disabled
NEXT_PUBLIC_ERROR_TRACKING_MODE=disabled
NEXT_PUBLIC_SENTRY_DSN=

# The browser SDK's environment label, and "1" to send default PII. Empty means
# no label and no PII. Declared so a deployment can set them: the frontend reads
# both, and a key no group declares is never delivered.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_SEND_PII=
