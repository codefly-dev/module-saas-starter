# The identity provider's own credentials: the ones that authenticate THIS HOST to
# the provider, as distinct from the `identity` group's public facts about it (the
# issuer, the client id, the display name, the scope) which the browser receives
# anyway.
#
# They live in a group of their own because of who declares what. The frontend
# declares `identity` — it renders the login page from those public facts — and a
# deployment that puts the provider's credentials in that same group delivers them
# to the frontend too, which never reads either. A public-facing process holding
# the provider's administration credential widens what a frontend compromise is
# worth, for nothing. Only accounts declares this group.

# The client secret the authorization-code exchange authenticates with. Required
# by every provider that performs that exchange; a real value is supplied through
# Codefly's secret configuration provider.
IDENTITY_CLIENT_SECRET=local-dev-only-replace-me

# The provider's management credential, used by the optional administration portal
# adapter. Unset leaves that adapter in stub mode; it is never required for
# sign-in.
IDENTITY_MANAGEMENT_API_KEY=local-dev-only-replace-me
