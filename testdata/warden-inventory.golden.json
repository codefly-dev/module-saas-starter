{
  "schemaVersion": "codefly.dev/module-gitops/v3",
  "workspace": "warden-control",
  "module": "identity",
  "ownedPath": "clusters/codefly/deployments/modules/identity",
  "environments": [
    {
      "name": "local",
      "namespace": "identity-local",
      "repository": "http://host.k3d.internal:8080/platform-config.git",
      "revision": "0123456789abcdef0123456789abcdef01234567",
      "services": [
        "accounts",
        "auth-sidecar",
        "cache",
        "frontend",
        "object-storage",
        "store",
        "vault"
      ],
      "servicePaths": {
        "accounts": "clusters/codefly/deployments/modules/identity/services/accounts/overlays/local",
        "auth-sidecar": "clusters/codefly/deployments/modules/identity/services/auth-sidecar/overlays/local",
        "cache": "clusters/codefly/deployments/modules/identity/services/cache/overlays/local",
        "frontend": "clusters/codefly/deployments/modules/identity/services/frontend/overlays/local",
        "object-storage": "clusters/codefly/deployments/modules/identity/services/object-storage/overlays/local",
        "store": "clusters/codefly/deployments/modules/identity/services/store/overlays/local",
        "vault": "clusters/codefly/deployments/modules/identity/services/vault/overlays/local"
      }
    },
    {
      "name": "aws",
      "namespace": "identity-aws",
      "repository": "git@github.com:acme/platform-config.git",
      "revision": "0123456789abcdef0123456789abcdef01234567",
      "services": [
        "accounts",
        "auth-sidecar",
        "frontend"
      ],
      "servicePaths": {
        "accounts": "clusters/codefly/deployments/modules/identity/services/accounts/overlays/aws",
        "auth-sidecar": "clusters/codefly/deployments/modules/identity/services/auth-sidecar/overlays/aws",
        "frontend": "clusters/codefly/deployments/modules/identity/services/frontend/overlays/aws"
      },
      "managedServiceHandoffs": [
        {
          "service": "cache",
          "awsKind": "elasticache",
          "externalName": "cache.internal.example.com"
        },
        {
          "service": "object-storage",
          "awsKind": "s3",
          "externalName": "object-storage.internal.example.com"
        },
        {
          "service": "store",
          "awsKind": "rds-postgresql",
          "externalName": "store.internal.example.com"
        },
        {
          "service": "vault",
          "awsKind": "secrets-manager",
          "externalName": "vault.internal.example.com"
        }
      ]
    }
  ]
}
