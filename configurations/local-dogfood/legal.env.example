# Copy to legal.env in this directory. Codefly loads it when the local-dogfood
# environment selects this configuration directory; the nextjs agent exposes
# these NEXT_PUBLIC_* values to the browser bundle (src/lib/legal-config.ts).
#
# All four are REQUIRED for the terms gate to open on a non-fixture run (real
# WorkOS). Missing or blank content fails the gate closed rather than shipping
# placeholder terms. Obtain jurisdiction-specific legal review before launch;
# in a real deployment these values come from the per-environment config
# (e.g. the fleet repo), not a hand-edited file.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Example, Inc.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=legal@example.com
NEXT_PUBLIC_LEGAL_TERMS_CONTENT=Replace with your operator Terms of Service.
NEXT_PUBLIC_LEGAL_PRIVACY_CONTENT=Replace with your operator Privacy Policy.
