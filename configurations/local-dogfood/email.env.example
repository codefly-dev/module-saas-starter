# Copy to email.env and fill it in. This profile is not the local environment,
# so accounts refuses to start without an explicit EMAIL_PROVIDER: `resend`
# (with email.secret.env), or `disabled` to run without email — invitations then
# hand the inviting administrator a link to share instead.
EMAIL_PROVIDER=resend
EMAIL_FROM=SaaS Starter <onboarding@example.com>
RESEND_API_BASE=https://api.resend.com
