# Copy to observability.env or run scripts/setup/otel.sh. SigNoz is the
# designated OTLP backend; this remains application instrumentation config.
# "debug" keeps telemetry local; "otlphttp" forwards through the collector.
OBSERVABILITY_EXPORTER=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
