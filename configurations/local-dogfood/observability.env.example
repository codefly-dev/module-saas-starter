# Copy to observability.env and fill it in. This module owns no collector: the
# cell's collector is where traces and metrics go, and the platform says where it is.
#
# A dogfood run on a laptop is not a cell, so by default it has none. Neither
# traces nor metrics are exported then: this profile is not the plain `local`
# runtime, and wool's stdout tracer belongs to that runtime alone. Logs still go
# to stdout.
TELEMETRY_STATE=absent
TELEMETRY_ABSENT_REASON=A local dogfood run has no cell collector; traces and metrics are not exported.

# To export to a collector this machine can reach (for example a cell's, through a
# port-forward), replace the two lines above with:
#
#   TELEMETRY_STATE=available
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#
# The endpoint is the collector's OTLP/gRPC address. http:// is plaintext, which
# only belongs on loopback or inside the mesh; https:// is TLS. Set the endpoint
# when the state is available and the reason when it is absent. The state decides: the
# other key is ignored, and the process logs that once.
