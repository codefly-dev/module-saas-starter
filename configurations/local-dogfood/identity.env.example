# Copy to identity.env in this directory. Codefly loads it when the
# local-dogfood environment selects this Codefly configuration directory.
IDENTITY_PROVIDER=workos
IDENTITY_DISPLAY_NAME=WorkOS
IDENTITY_CLIENT_ID=client_REPLACE_ME
IDENTITY_AUTHORIZE_URL=https://api.workos.com/user_management/authorize
IDENTITY_TOKEN_URL=https://api.workos.com/user_management/authenticate
IDENTITY_ISSUER=https://api.workos.com
IDENTITY_JWKS_URL=https://api.workos.com/sso/jwks/client_REPLACE_ME
IDENTITY_AUTHORIZE_SELECTOR=authkit
# Optional fallback for traffic that intentionally bypasses auth-gateway.
IDENTITY_ALLOWED_REDIRECT_URIS=
# Gate signup only (login and invite are never gated): open | invite | waitlist.
# Defaults to open when unset; unrecognised values fail startup closed.
IDENTITY_SIGNUP_MODE=open
# Admit Client ID Metadata Document clients — how an MCP client (Claude Code,
# Claude Desktop, a Claude.ai connector) registers itself. Unset refuses them;
# `any` admits any document that validates; a comma-separated list admits only
# those exact client_id URLs.
IDENTITY_CLIENT_METADATA_DOCUMENTS=
