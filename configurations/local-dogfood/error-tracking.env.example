# Copy to error-tracking.env or run scripts/setup/sentry.sh. Sentry captures
# errors only; application traces, metrics, and logs use OpenTelemetry.
ERROR_TRACKING_MODE=sentry
NEXT_PUBLIC_ERROR_TRACKING_MODE=sentry
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local-dogfood
