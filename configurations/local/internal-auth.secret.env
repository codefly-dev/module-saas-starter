# Local development only. Production environments must supply a unique,
# high-entropy value through Codefly's secret configuration provider.
CODEFLY_INTERNAL_TOKEN=local-dev-only-replace-me
# Authenticates identity headers stamped by auth-sidecar. Keep distinct from
# the internal RPC token so gateway compromise does not unlock internal APIs.
CODEFLY_GATEWAY_TOKEN=local-dev-gateway-only-replace-me
